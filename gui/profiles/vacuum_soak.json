{
  "name": "Vacuum soak, 3 channels",
  "loops": 4,
  "zero_on_finish": true,
  "steps": [
    {
      "label": "settle at rest",
      "hold_s": 10,
      "set": [
        {"reg": 1, "kPa": -1.3},
        {"reg": 2, "kPa": -1.3},
        {"reg": 3, "kPa": -1.3},
        {"reg": 4, "kPa": 1}
      ]
    },
    {
      "label": "pressurise air to 100 kPa",
      "hold_s": 30,
      "set": [{"reg": 4, "kPa": 100}]
    },
    {
      "label": "draw vacuum on all three",
      "hold_s": 600,
      "set": [
        {"reg": 1, "kPa": -40},
        {"reg": 2, "kPa": -40},
        {"reg": 3, "kPa": -40}
      ]
    },
    {
      "label": "deep vacuum hold",
      "hold_s": 900,
      "set": [
        {"reg": 1, "kPa": -70},
        {"reg": 2, "kPa": -70},
        {"reg": 3, "kPa": -70}
      ]
    },
    {
      "label": "vent",
      "hold_s": 30,
      "set": [
        {"reg": 1, "kPa": -1.3},
        {"reg": 2, "kPa": -1.3},
        {"reg": 3, "kPa": -1.3},
        {"reg": 4, "kPa": 1}
      ]
    }
  ]
}
